APP_NAME=TRUSTSCORE
API_HOST=127.0.0.1
API_PORT=8000
# DATABASE_URL=sqlite:///./database/http.db
SECRET_KEY=change-this-to-a-long-random-string-before-any-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=120
MAX_UPLOAD_MB=10
MAX_VIDEO_MB=60
RATE_LIMIT_PER_MINUTE=20

# ---- Evidence providers (optional; keys stay on the backend) ----
# Free key: Google Cloud console -> enable "Fact Check Tools API" -> create API key
GOOGLE_FACTCHECK_API_KEY=
# Free tier: https://tavily.com
TAVILY_API_KEY=
# Free key: Google Cloud console -> enable "Safe Browsing API"
GOOGLE_SAFE_BROWSING_API_KEY=
# Free, no key (need internet)
ENABLE_GDELT=true
ENABLE_WIKIPEDIA=true
ENABLE_RDAP=true
MAX_CLAIMS_TO_CHECK=3

# ---- Optional local AI models (pip install -r requirements-ml.txt) ----
ENABLE_HF_MODELS=false
# HF_IMAGE_DETECTOR_MODEL=umm-maybe/AI-image-detector

# ---- Optional LLM: smarter Ignis answers + evidence stance judgement ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- SIMULATED authority connectors (prototype only) ----
UIDAI_API_KEY=demo-uidai-key
ECI_API_KEY=demo-eci-key
PAN_API_KEY=demo-pan-key
DEPARTMENT_API_KEY=demo-department-key
